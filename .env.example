# TripMate local example only. Never commit real secrets.
TRIPMATE_ENV=development
TRIPMATE_SECRET_KEY=replace-with-local-secret
# Generic SECRET_KEY is also supported when a platform requires it.
# SECRET_KEY=

# Optional database overrides. Leave empty to use instance/tripmate.db.
TRIPMATE_DATABASE_URI=
DATABASE_URL=

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Optional presentation enhancement. Empty uses bundled local travel images.
UNSPLASH_ACCESS_KEY=

# Enable only when deployed behind exactly one trusted reverse proxy.
TRIPMATE_TRUST_PROXY=false
LOG_LEVEL=INFO
